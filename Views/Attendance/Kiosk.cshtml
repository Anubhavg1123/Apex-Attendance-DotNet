@model List<EmployeeAttendanceApp.Models.Employee>
@{
    Layout = null;
    var todayPunches = ViewBag.TodayPunches as List<EmployeeAttendanceApp.Models.AttendanceRecord> ?? new();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Apex Kiosk - Automated Biometric Face Punch Console</title>
    
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        body.kiosk-body {
            background: #030712;
            color: #f3f4f6;
            margin: 0;
            padding: 0;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .kiosk-top-nav {
            height: 70px;
            background: rgba(13, 20, 36, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            z-index: 100;
        }

        .kiosk-grid {
            display: grid;
            grid-template-columns: 1fr 420px;
            height: calc(100vh - 70px);
            overflow: hidden;
        }

        .kiosk-scanner-pane {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px;
            position: relative;
            background: radial-gradient(circle at center, rgba(6, 182, 212, 0.05) 0%, rgba(3, 7, 18, 1) 70%);
        }

        .kiosk-camera-viewport {
            position: relative;
            width: 640px;
            height: 480px;
            max-width: 90%;
            max-height: 65vh;
            border-radius: 20px;
            overflow: hidden;
            border: 2px solid rgba(56, 189, 248, 0.3);
            box-shadow: 0 0 50px rgba(6, 182, 212, 0.15), inset 0 0 30px rgba(0, 0, 0, 0.8);
            background: #000;
        }

        .kiosk-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scaleX(-1);
        }

        .kiosk-hud-crosshairs {
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .kiosk-target-oval {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 250px;
            height: 330px;
            border: 2px dashed rgba(56, 189, 248, 0.5);
            border-radius: 50%;
            transition: all 0.3s ease;
        }

        .kiosk-target-oval.detected {
            border-color: #10b981;
            border-style: solid;
            box-shadow: 0 0 30px rgba(16, 185, 129, 0.35);
        }

        .kiosk-target-oval.rejected {
            border-color: #ef4444;
            border-style: solid;
            box-shadow: 0 0 30px rgba(239, 68, 68, 0.4);
        }

        .celebration-card {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(13, 20, 36, 0.95);
            backdrop-filter: blur(16px);
            border: 2px solid #10b981;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(16, 185, 129, 0.3);
            border-radius: 16px;
            padding: 16px 28px;
            display: flex;
            align-items: center;
            gap: 20px;
            z-index: 50;
            animation: slideUpFade 0.4s ease-out;
            min-width: 480px;
            max-width: 90%;
        }

        .alert-card-kiosk {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(16px);
            border-radius: 16px;
            padding: 16px 28px;
            display: flex;
            align-items: center;
            gap: 20px;
            z-index: 50;
            animation: slideUpFade 0.4s ease-out;
            min-width: 480px;
            max-width: 90%;
        }

        @@keyframes slideUpFade {
            from {
                opacity: 0;
                transform: translate(-50%, 30px);
            }
            to {
                opacity: 1;
                transform: translate(-50%, 0);
            }
        }

        .kiosk-feed-pane {
            background: rgba(13, 20, 36, 0.6);
            backdrop-filter: blur(12px);
            border-left: 1px solid rgba(255, 255, 255, 0.08);
            padding: 24px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .kiosk-feed-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: fadeIn 0.3s ease;
        }

        .kiosk-feed-card:hover {
            border-color: rgba(56, 189, 248, 0.3);
            background: rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body class="kiosk-body">
    <!-- Top Header Navigation -->
    <div class="kiosk-top-nav">
        <div class="d-flex align-items-center gap-3">
            <div class="avatar-circle" style="width: 44px; height: 44px; background: rgba(6, 182, 212, 0.2); border-color: rgba(6, 182, 212, 0.4);">
                <i class="bi bi-shield-lock-fill text-cyan fs-5"></i>
            </div>
            <div>
                <h1 class="h5 fw-bold text-white mb-0 font-mono tracking-wide">
                    APEX ATTENDANCE KIOSK
                </h1>
                <span class="text-secondary small font-mono">
                    TERMINAL ID: <span class="text-cyan">HQ-KIOSK-01</span> &bull; 
                    <span class="text-success"><i class="bi bi-circle-fill" style="font-size: 8px;"></i> LIVE</span>
                </span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-4">
            <div class="text-end">
                <div id="kioskClock" class="fw-bold font-mono text-white fs-4">00:00:00</div>
                <div class="text-secondary small font-mono">@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</div>
            </div>
            <button type="button" class="btn-apex-secondary btn-sm" onclick="toggleFullscreen()">
                <i class="bi bi-arrows-fullscreen"></i>
            </button>
            <a href="/Dashboard" class="btn-apex-secondary btn-sm">
                <i class="bi bi-door-closed"></i> Exit
            </a>
        </div>
    </div>

    <!-- Main Kiosk Layout -->
    <div class="kiosk-grid">
        <!-- Left: Facial Recognition Viewport -->
        <div class="kiosk-scanner-pane">
            <div class="kiosk-camera-viewport">
                <video id="kioskVideo" class="kiosk-video" autoplay playsinline muted></video>
                <canvas id="kioskCanvas" class="scanner-canvas-overlay"></canvas>

                <!-- HUD Crosshairs & Oval -->
                <div class="kiosk-hud-crosshairs">
                    <div class="hud-corner top-left"></div>
                    <div class="hud-corner top-right"></div>
                    <div class="hud-corner bottom-left"></div>
                    <div class="hud-corner bottom-right"></div>
                    <div id="kioskFaceOval" class="kiosk-target-oval"></div>
                    <div class="scanner-laser"></div>
                    <div class="radar-ring"></div>
                </div>

                <!-- HUD Status Overlays -->
                <div style="position: absolute; top: 16px; left: 20px; background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); padding: 5px 12px; border-radius: 8px; border: 1px solid rgba(56,189,248,0.3); font-family: var(--font-mono); font-size: 11px;">
                    <span class="text-cyan"><i class="bi bi-cpu me-1"></i> NEURAL DESCRIPTOR: 128-D EMBEDDING</span>
                </div>

                <div style="position: absolute; top: 16px; right: 20px; background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); padding: 5px 12px; border-radius: 8px; border: 1px solid rgba(16,185,129,0.3); font-family: var(--font-mono); font-size: 11px;">
                    <span id="kioskConfidenceBadge" class="text-success fw-bold">ALIGNING FACE...</span>
                </div>

                <!-- Bottom Telemetry Readout -->
                <div style="position: absolute; bottom: 16px; left: 20px; right: 20px; display: flex; justify-content: space-between; background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); padding: 8px 16px; border-radius: 10px; font-family: var(--font-mono); font-size: 12px;">
                    <span class="text-secondary">MODE: <strong class="text-white">AUTO-DETECT & PUNCH</strong></span>
                    <span class="text-secondary">THRESHOLD: <strong class="text-cyan">85.0% CONFIDENCE</strong></span>
                </div>
            </div>

            <!-- Manual Punch Option for Testing / Backup -->
            <div class="d-flex align-items-center gap-3 mt-4">
                <span class="text-secondary small">Staff Manual Fallback:</span>
                <select id="kioskManualSelect" class="apex-input py-1 px-3" style="width: 260px; font-size: 13px;">
                    <option value="">-- Select Staff to Punch --</option>
                    @foreach (var emp in Model.Where(e => e.IsActive))
                    {
                        <option value="@emp.Id">@emp.EmployeeCode - @emp.FullName</option>
                    }
                </select>
                <button type="button" class="btn-apex-primary py-1 px-3 small" onclick="triggerManualKioskPunch()">
                    <i class="bi bi-shield-check"></i> Punch Now
                </button>
            </div>

            <!-- 1. Pop-Up: EMPLOYEE RECOGNIZED CARD -->
            <div id="celebrationCard" class="celebration-card d-none">
                <div id="celebPhotoWrapper">
                    <img id="celebPhoto" src="" alt="Employee" style="width: 70px; height: 70px; border-radius: 50%; object-fit: cover; border: 3px solid #10b981; display: none;" />
                    <div id="celebAvatar" class="avatar-circle" style="width: 70px; height: 70px; font-size: 26px; border-color: #10b981; background: #064e3b;">
                        <i class="bi bi-person-check-fill text-success"></i>
                    </div>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-success font-mono" id="celebAction">CHECK-IN</span>
                        <span class="badge bg-dark border border-success text-success font-mono" id="celebConfidence">98.5% Biometric Match</span>
                    </div>
                    <div class="text-success fw-bold font-mono" style="font-size: 11px; letter-spacing: 0.5px;">EMPLOYEE RECOGNIZED</div>
                    <h3 class="h4 fw-bold text-white mb-0" id="celebName">Anubhav</h3>
                    <div class="text-light small mt-1">
                        <strong>Employee ID:</strong> <span id="celebEmpCode" class="text-cyan font-mono fw-bold">APX-101</span> &bull; 
                        <strong>Department:</strong> <span id="celebDept">IT</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mt-2 pt-1 border-top border-secondary border-opacity-25 small font-mono">
                        <span class="text-warning"><i class="bi bi-clock-history"></i> <span id="celebTime">09:00:00 AM</span></span>
                        <span class="text-success fw-semibold ms-2"><i class="bi bi-check-circle-fill"></i> ATTENDANCE RECORDED SUCCESSFULLY</span>
                    </div>
                </div>
            </div>

            <!-- 2. Pop-Up: UNKNOWN FACE (NOT REGISTERED) CARD -->
            <div id="unknownFaceCard" class="alert-card-kiosk border border-danger d-none" style="background: rgba(30, 10, 10, 0.95); box-shadow: 0 0 35px rgba(239, 68, 68, 0.35);">
                <div class="avatar-circle" style="width: 65px; height: 65px; font-size: 28px; border-color: #ef4444; background: #450a0a;">
                    <i class="bi bi-person-x-fill text-danger"></i>
                </div>
                <div>
                    <div class="badge bg-danger text-white font-mono mb-1">NOT REGISTERED</div>
                    <h4 class="h5 fw-bold text-white mb-1">Face Not Recognized</h4>
                    <p class="text-light small mb-0">
                        This face is not registered in the employee attendance system. Please contact the administrator.
                    </p>
                    <div class="text-secondary small font-mono mt-1">
                        <i class="bi bi-shield-slash"></i> Attendance punch was not created.
                    </div>
                </div>
            </div>

            <!-- 3. Pop-Up: AMBIGUOUS FACE CARD -->
            <div id="ambiguousFaceCard" class="alert-card-kiosk border border-warning d-none" style="background: rgba(35, 25, 10, 0.95); box-shadow: 0 0 35px rgba(245, 158, 11, 0.35);">
                <div class="avatar-circle" style="width: 65px; height: 65px; font-size: 28px; border-color: #f59e0b; background: #78350f;">
                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                </div>
                <div>
                    <div class="badge bg-warning text-dark font-mono mb-1">AMBIGUOUS BIOMETRIC MATCH</div>
                    <h4 class="h5 fw-bold text-white mb-1">Multiple Potential Profiles Detected</h4>
                    <p class="text-light small mb-0">
                        Insufficient statistical distinction between multiple profiles. Please adjust distance or lighting.
                    </p>
                </div>
            </div>
        </div>

        <!-- Right Side: Today's Live Attendance Feed -->
        <div class="kiosk-feed-pane">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-white mb-0" style="font-size: 16px;">
                    <i class="bi bi-activity text-cyan me-1"></i> Live Terminal Feed
                </h5>
                <span id="kioskFeedCount" class="badge bg-info bg-opacity-25 text-info font-mono">@todayPunches.Count Punches</span>
            </div>

            <div id="kioskFeedList" class="flex-grow-1">
                @if (todayPunches.Any())
                {
                    foreach (var p in todayPunches)
                    {
                        <div class="kiosk-feed-card">
                            <div class="avatar-circle" style="width: 44px; height: 44px;">
                                @if (!string.IsNullOrEmpty(p.PunchInPhoto))
                                {
                                    <img src="@p.PunchInPhoto" alt="@p.EmployeeName" />
                                }
                                else
                                {
                                    <span>@p.EmployeeName.Substring(0, 1)</span>
                                }
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-white small text-truncate">@p.EmployeeName</div>
                                <div class="text-muted font-mono" style="font-size: 11px;">
                                    @p.PunchInTime.ToString("hh:mm tt") &bull; @p.Department
                                </div>
                            </div>
                            <div>
                                @if (p.Status == "Present")
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success font-mono" style="font-size: 10px;">ON TIME</span>
                                }
                                else if (p.Status == "Late")
                                {
                                    <span class="badge bg-warning bg-opacity-25 text-warning font-mono" style="font-size: 10px;">LATE</span>
                                }
                                else
                                {
                                    <span class="badge bg-info bg-opacity-25 text-info font-mono" style="font-size: 10px;">@p.Status</span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div id="kioskEmptyFeed" class="text-center text-muted py-5">
                        <i class="bi bi-person-video fs-1 d-block mb-2 text-secondary"></i>
                        Awaiting staff entrance...
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Biometric Scripts -->
    <script src="~/js/biometric.js" asp-append-version="true"></script>
    <script>
        let isKioskCooldown = false;
        let lastUnknownWarningTime = 0;
        let scanInterval = null;

        // Digital Clock
        function updateKioskClock() {
            const now = new Date();
            const time = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
            document.getElementById('kioskClock').textContent = time;
        }
        setInterval(updateKioskClock, 1000);
        updateKioskClock();

        // Toggle Fullscreen
        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => {});
            } else {
                document.exitFullscreen().catch(err => {});
            }
        }

        // Initialize Kiosk
        document.addEventListener('DOMContentLoaded', async () => {
            const video = document.getElementById('kioskVideo');
            const canvas = document.getElementById('kioskCanvas');
            const oval = document.getElementById('kioskFaceOval');

            await window.apexBiometrics.loadEnrolledProfiles();

            const camRes = await window.apexBiometrics.startCamera(video, canvas);
            if (camRes.success) {
                oval.classList.add('detected');
                startKioskContinuousScanning();
            } else {
                document.getElementById('kioskConfidenceBadge').textContent = 'CAMERA OFFLINE';
                document.getElementById('kioskConfidenceBadge').className = 'text-danger fw-bold';
            }
        });

        // Continuous Neural Scan Loop
        function startKioskContinuousScanning() {
            if (scanInterval) clearInterval(scanInterval);

            scanInterval = setInterval(async () => {
                if (isKioskCooldown) return;

                // Extract live descriptor
                const descriptor = window.apexBiometrics.extractDescriptorFromVideo();
                if (!descriptor || descriptor.error) return;

                // Match against active enrolled employees
                const matchResult = window.apexBiometrics.findBestMatch(descriptor);
                const badge = document.getElementById('kioskConfidenceBadge');
                const oval = document.getElementById('kioskFaceOval');

                if (matchResult && matchResult.employee && matchResult.isMatch) {
                    oval.className = 'kiosk-target-oval detected';
                    badge.textContent = `${matchResult.confidence}% MATCH: ${matchResult.employee.fullName.toUpperCase()}`;
                    badge.className = 'text-success fw-bold';

                    // Trigger Automatic Attendance Punch
                    await triggerKioskPunch(matchResult.employee, matchResult.confidence);
                } else if (matchResult && matchResult.isAmbiguous) {
                    oval.className = 'kiosk-target-oval rejected';
                    badge.textContent = 'AMBIGUOUS BIOMETRIC MATCH';
                    badge.className = 'text-warning fw-bold';
                    showAmbiguousCard();
                } else if (matchResult && matchResult.distance > 0.40) {
                    // Face is present, but NO employee matches this face
                    oval.className = 'kiosk-target-oval rejected';
                    badge.textContent = 'NOT REGISTERED';
                    badge.className = 'text-danger fw-bold';
                    showUnknownFaceCard();
                } else {
                    oval.className = 'kiosk-target-oval detected';
                    badge.textContent = 'SCANNING FOR REGISTERED STAFF...';
                    badge.className = 'text-info fw-bold';
                }
            }, 800);
        }

        async function triggerKioskPunch(employee, confidence) {
            if (isKioskCooldown) return;
            isKioskCooldown = true;

            const photo = window.apexBiometrics.captureSnapshot(0.85);

            try {
                const res = await fetch('/Attendance/Punch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        employeeId: employee.id,
                        employeeCode: employee.employeeCode,
                        matchConfidence: confidence,
                        photoDataUri: photo,
                        deviceLocation: 'HQ Main Entrance Kiosk'
                    })
                });

                const data = await res.json();
                if (data.success) {
                    // Audio Chime & Speech
                    window.apexBiometrics.playSuccessChime();
                    window.apexBiometrics.speak(`Welcome, ${data.employeeName}. Attendance registered.`);

                    // Display Recognized Employee Card
                    showCelebrationCard(data, employee, photo);

                    // Add to right side feed
                    prependKioskFeed(data, photo);
                }
            } catch (err) {
                console.error("Kiosk punch error", err);
            }

            // Cooldown for 6 seconds so the same person isn't punched repeatedly
            setTimeout(() => {
                isKioskCooldown = false;
            }, 6000);
        }

        function showCelebrationCard(data, employee, photo) {
            hideAlertCards();
            const card = document.getElementById('celebrationCard');
            document.getElementById('celebAction').textContent = data.action.toUpperCase();
            document.getElementById('celebName').textContent = data.employeeName;
            document.getElementById('celebEmpCode').textContent = data.employeeCode || (employee ? employee.employeeCode : 'STAFF');
            document.getElementById('celebDept').textContent = data.department;
            document.getElementById('celebTime').textContent = data.timeFormatted;
            document.getElementById('celebConfidence').textContent = `${data.matchConfidence}% Biometric Match`;

            const imgEl = document.getElementById('celebPhoto');
            const avatarEl = document.getElementById('celebAvatar');
            if (photo || (employee && employee.profilePhotoUrl)) {
                imgEl.src = photo || employee.profilePhotoUrl;
                imgEl.style.display = 'block';
                avatarEl.style.display = 'none';
            } else {
                imgEl.style.display = 'none';
                avatarEl.style.display = 'flex';
            }

            card.classList.remove('d-none');
            setTimeout(() => {
                card.classList.add('d-none');
            }, 5500);
        }

        function showUnknownFaceCard() {
            const now = Date.now();
            if (now - lastUnknownWarningTime < 4500) return;
            lastUnknownWarningTime = now;

            hideAlertCards();
            window.apexBiometrics.playWarningSound();
            const card = document.getElementById('unknownFaceCard');
            card.classList.remove('d-none');
            setTimeout(() => {
                card.classList.add('d-none');
            }, 4000);
        }

        function showAmbiguousCard() {
            const now = Date.now();
            if (now - lastUnknownWarningTime < 4500) return;
            lastUnknownWarningTime = now;

            hideAlertCards();
            window.apexBiometrics.playWarningSound();
            const card = document.getElementById('ambiguousFaceCard');
            card.classList.remove('d-none');
            setTimeout(() => {
                card.classList.add('d-none');
            }, 4000);
        }

        function hideAlertCards() {
            document.getElementById('celebrationCard').classList.add('d-none');
            document.getElementById('unknownFaceCard').classList.add('d-none');
            document.getElementById('ambiguousFaceCard').classList.add('d-none');
        }

        function prependKioskFeed(data, photo) {
            const emptyEl = document.getElementById('kioskEmptyFeed');
            if (emptyEl) emptyEl.remove();

            const feed = document.getElementById('kioskFeedList');
            const card = document.createElement('div');
            card.className = 'kiosk-feed-card';

            const photoHtml = photo 
                ? `<img src="${photo}" alt="${data.employeeName}" />`
                : `<span>${data.employeeName.substring(0, 1)}</span>`;

            card.innerHTML = `
                <div class="avatar-circle" style="width: 44px; height: 44px;">
                    ${photoHtml}
                </div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="fw-bold text-white small text-truncate">${data.employeeName}</div>
                    <div class="text-muted font-mono" style="font-size: 11px;">
                        ${data.timeFormatted} &bull; ${data.department}
                    </div>
                </div>
                <div>
                    <span class="badge bg-success bg-opacity-25 text-success font-mono" style="font-size: 10px;">${data.status.toUpperCase()}</span>
                </div>
            `;

            feed.prepend(card);
            const countEl = document.getElementById('kioskFeedCount');
            if (countEl) {
                const total = feed.querySelectorAll('.kiosk-feed-card').length;
                countEl.textContent = `${total} Punches`;
            }
        }

        async function triggerManualKioskPunch() {
            const sel = document.getElementById('kioskManualSelect');
            const empId = sel.value;
            if (!empId) {
                alert("Please select an employee.");
                return;
            }

            const emp = window.apexBiometrics.enrolledEmployees.find(e => e.id == empId);
            if (emp) {
                await triggerKioskPunch(emp, 98.4);
                sel.value = '';
            }
        }
    </script>
</body>
