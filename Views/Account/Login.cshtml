@model EmployeeAttendanceApp.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Administrator Login - Apex Biometric Attendance</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3.3 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: var(--bg-base);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background: rgba(14, 22, 38, 0.85);
            backdrop-filter: blur(24px);
            border: 1px solid var(--border-glow);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), 0 0 30px rgba(6, 182, 212, 0.2);
            border-radius: var(--radius-lg);
            padding: 40px 32px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <!-- Logo -->
        <div class="text-center mb-4">
            <div class="brand-icon-box mx-auto mb-3" style="width: 54px; height: 54px; font-size: 26px;">
                <i class="bi bi-person-bounding-box"></i>
            </div>
            <h2 class="h4 fw-bold text-white mb-1">Apex Attendance AI</h2>
            <p class="text-secondary small">Biometric Face Authorization & Enterprise Management</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 px-3 small border-danger text-white mb-4 bg-danger bg-opacity-25">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div><i class="bi bi-exclamation-circle me-1"></i> @err.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="Login" method="post" class="d-flex flex-column gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div>
                <label class="apex-label">Username</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-secondary">
                        <i class="bi bi-person"></i>
                    </span>
                    <input type="text" asp-for="Username" id="loginUsername" class="apex-input font-mono" placeholder="e.g. admin" required autofocus />
                </div>
            </div>

            <div>
                <label class="apex-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-secondary">
                        <i class="bi bi-key"></i>
                    </span>
                    <input type="password" asp-for="Password" id="loginPassword" class="apex-input font-mono" placeholder="••••••••" required />
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-1">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberCheck" />
                    <label class="form-check-label text-secondary small" for="rememberCheck">Keep me signed in</label>
                </div>
            </div>

            <button type="submit" class="btn-apex-primary py-2 mt-2 w-100 justify-content-center">
                <i class="bi bi-box-arrow-in-right"></i> Sign In to Portal
            </button>

            <!-- Quick Auto-Fill Helper -->
            <button type="button" class="btn btn-outline-secondary btn-sm text-secondary border-opacity-25 mt-1" onclick="autoFillAdmin()">
                <i class="bi bi-magic text-cyan me-1"></i> Auto-Fill Admin Credentials (admin / Admin@123)
            </button>
        </form>

        <div class="mt-4 pt-4 border-top border-secondary border-opacity-25 text-center">
            <span class="text-secondary small d-block mb-2">Tablet or Entrance Terminal?</span>
            <a href="/Attendance/Kiosk" class="btn btn-outline-info btn-sm w-100 font-mono">
                <i class="bi bi-camera-video me-1"></i> Launch Autonomous Kiosk
            </a>
        </div>
    </div>

    <script>
        function autoFillAdmin() {
            document.getElementById('loginUsername').value = 'admin';
            document.getElementById('loginPassword').value = 'Admin@123';
        }
    </script>
</body>
</html>
