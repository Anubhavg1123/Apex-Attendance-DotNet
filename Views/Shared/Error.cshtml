@{
    ViewData["Title"] = "Error";
}

<div class="glass-panel p-5 text-center my-5" style="max-width: 600px; margin: 0 auto;">
    <div class="avatar-circle mx-auto mb-3" style="width: 70px; height: 70px; font-size: 32px; background: rgba(244,63,94,0.15); border-color: #f43f5e; color: #f43f5e;">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h3 class="fw-bold text-white mb-2">Unexpected System Exception</h3>
    <p class="text-secondary mb-4">An error occurred while processing the biometric telemetry request.</p>
    <a href="/Dashboard" class="btn-apex-primary">
        <i class="bi bi-arrow-left"></i> Return to Dashboard
    </a>
</div>
