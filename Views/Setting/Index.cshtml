@model EmployeeAttendanceApp.Models.AttendancePolicy
@{
    ViewData["Title"] = "Policy & Biometric Settings";
}

<div class="d-flex flex-column gap-4" style="max-width: 800px; margin: 0 auto;">
    <div>
        <h2 class="h3 fw-bold text-white mb-1">
            Corporate Policy & Biometric Neural Settings
        </h2>
        <p class="text-secondary mb-0">
            Define corporate work timings, late grace thresholds, and facial verification confidence parameters.
        </p>
    </div>

    <form asp-action="Index" method="post" class="glass-panel p-4 d-flex flex-column gap-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <!-- 1. Corporate Identity -->
        <div>
            <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-buildings text-cyan"></i>
                <span>1. Organization Info</span>
            </h5>
            <div>
                <label class="apex-label">Organization Name</label>
                <input type="text" asp-for="CompanyName" class="apex-input" required />
            </div>
        </div>

        <hr class="border-secondary border-opacity-25 my-1" />

        <!-- 2. Shift & Work Hour Parameters -->
        <div>
            <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-cyan"></i>
                <span>2. Shift & Punctuality Rules</span>
            </h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="apex-label">Standard Shift Start Time</label>
                    <input type="time" asp-for="ShiftStartTime" class="apex-input font-mono" required />
                </div>
                <div class="col-md-6">
                    <label class="apex-label">Standard Shift End Time</label>
                    <input type="time" asp-for="ShiftEndTime" class="apex-input font-mono" required />
                </div>
                <div class="col-md-4">
                    <label class="apex-label">Late Grace Window (minutes)</label>
                    <input type="number" asp-for="LateGraceMinutes" class="apex-input font-mono" min="0" max="60" required />
                    <span class="text-muted" style="font-size: 11px;">Arriving after this marks employee as Late.</span>
                </div>
                <div class="col-md-4">
                    <label class="apex-label">Standard Work Hours</label>
                    <input type="number" step="0.5" asp-for="StandardWorkHours" class="apex-input font-mono" required />
                </div>
                <div class="col-md-4">
                    <label class="apex-label">Minimum Half-Day Hours</label>
                    <input type="number" step="0.5" asp-for="HalfDayMinimumHours" class="apex-input font-mono" required />
                </div>
            </div>
        </div>

        <hr class="border-secondary border-opacity-25 my-1" />

        <!-- 3. Biometric Confidence Slider -->
        <div>
            <h5 class="fw-bold text-white mb-2 d-flex align-items-center gap-2">
                <i class="bi bi-fingerprint text-cyan"></i>
                <span>3. Biometric Verification Rigor</span>
            </h5>
            <p class="text-secondary small mb-3">
                Faces with similarity score below this threshold will be denied authorization to prevent proxy punches.
            </p>

            <div class="p-3 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small">Required Match Confidence:</span>
                    <span id="confidenceSliderValue" class="text-cyan font-mono fw-bold fs-5">@Model.RequiredMatchConfidence%</span>
                </div>
                <input type="range" class="form-range" asp-for="RequiredMatchConfidence" min="80" max="98" step="1" id="confidenceRangeInput" oninput="document.getElementById('confidenceSliderValue').textContent = this.value + '%'" />
                <div class="d-flex justify-content-between text-muted" style="font-size: 11px;">
                    <span>80% (Lenient)</span>
                    <span class="text-success">90% (Recommended Standard)</span>
                    <span class="text-danger">98% (High Security)</span>
                </div>
            </div>
        </div>

        <hr class="border-secondary border-opacity-25 my-1" />

        <!-- 4. Automation Toggles -->
        <div class="d-flex flex-column gap-2">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" asp-for="AllowKioskDirectPunches" id="allowKioskSwitch" />
                <label class="form-check-label text-white ms-2" for="allowKioskSwitch">Enable Entrance Kiosk Automatic Punch Authorization</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" asp-for="AutoCheckoutAtMidnight" id="autoCheckoutSwitch" />
                <label class="form-check-label text-white ms-2" for="autoCheckoutSwitch">Automatically close active shifts at midnight</label>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-3 pt-3 border-top border-secondary border-opacity-25">
            <button type="submit" class="btn-apex-primary px-5 py-2">
                <i class="bi bi-save"></i> Save Settings
            </button>
        </div>
    </form>
</div>
