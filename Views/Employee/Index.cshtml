@model List<EmployeeAttendanceApp.Models.Employee>
@{
    ViewData["Title"] = "Staff Directory";
    var departments = ViewBag.Departments as List<EmployeeAttendanceApp.Models.Department> ?? new();
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentDepartment = ViewBag.CurrentDepartment as string;
}

<div class="d-flex flex-column gap-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h2 class="h3 fw-bold text-white mb-1">
                Corporate Staff Directory
            </h2>
            <p class="text-secondary mb-0">
                Manage employee profiles, biometric enrollment vectors, and shift assignments.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Employee/Create" class="btn-apex-primary">
                <i class="bi bi-person-plus-fill"></i>
                <span>Register & Enroll Staff</span>
            </a>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="glass-panel p-3">
        <form method="get" action="/Employee" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-secondary">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" class="apex-input" placeholder="Search by name, employee code, or email..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="department" class="apex-input">
                    <option value="All">All Departments</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Name" selected="@(currentDepartment == d.Name)">@d.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn-apex-secondary flex-fill">
                    <i class="bi bi-filter"></i> Apply Filter
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || (!string.IsNullOrEmpty(currentDepartment) && currentDepartment != "All"))
                {
                    <a href="/Employee" class="btn btn-outline-danger btn-sm d-flex align-items-center" title="Reset Filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Employee Cards / Grid -->
    <div class="glass-panel p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="h5 fw-bold text-white mb-0">Enrolled Personnel (@Model.Count)</h4>
            <div class="text-muted small font-mono">
                <i class="bi bi-camera-fill text-cyan me-1"></i> Biometric Facial Capture Enabled
            </div>
        </div>

        <div class="table-responsive">
            <table class="apex-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Shift Schedule</th>
                        <th>Biometric Status</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var emp in Model)
                        {
                            <tr>
                                <td>
                                    <div class="employee-cell">
                                        <div class="avatar-circle">
                                            @if (!string.IsNullOrEmpty(emp.ProfilePhotoUrl))
                                            {
                                                <img src="@emp.ProfilePhotoUrl" alt="@emp.FullName" />
                                            }
                                            else
                                            {
                                                <span>@emp.FullName.Substring(0, 1)</span>
                                            }
                                        </div>
                                        <div>
                                            <a href="/Employee/Details/@emp.Id" class="fw-bold text-white text-decoration-none hover-cyan">
                                                @emp.FullName
                                            </a>
                                            <div class="text-muted font-mono" style="font-size: 11px;">@emp.EmployeeCode &bull; @emp.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-secondary">@emp.Department</span>
                                </td>
                                <td>
                                    <span class="text-white">@emp.Designation</span>
                                </td>
                                <td>
                                    <span class="text-secondary small font-mono">@emp.ShiftType</span>
                                </td>
                                <td>
                                    @if (emp.IsFaceEnrolled)
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success font-mono px-2 py-1 border border-success border-opacity-25">
                                            <i class="bi bi-check-circle-fill me-1"></i> ENROLLED (128-D)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-warning font-mono px-2 py-1 border border-warning border-opacity-25">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> PENDING SCAN
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (emp.IsActive)
                                    {
                                        <span class="badge bg-info bg-opacity-25 text-cyan font-mono" style="font-size: 10px;">ACTIVE</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary font-mono" style="font-size: 10px;">INACTIVE</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a href="/Employee/Details/@emp.Id" class="btn btn-outline-info btn-sm" title="View Profile">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/Employee/Edit/@emp.Id" class="btn btn-outline-warning btn-sm" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger btn-sm" title="Delete" onclick="deleteEmployee(@emp.Id, '@emp.FullName')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                                No employee profiles matched the criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteEmployee(id, name) {
            Swal.fire({
                title: 'Delete Employee?',
                text: `Are you sure you want to remove ${name} from the active directory?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                cancelButtonColor: '#334155',
                confirmButtonText: 'Yes, Delete',
                background: '#0d1424',
                color: '#fff'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const res = await fetch(`/Employee/Delete?id=${id}`, { method: 'POST' });
                    const data = await res.json();
                    if (data.success) {
                        Swal.fire({
                            title: 'Deleted!',
                            text: `${name} has been removed.`,
                            icon: 'success',
                            background: '#0d1424',
                            color: '#fff',
                            confirmButtonColor: '#10b981'
                        }).then(() => window.location.reload());
                    }
                }
            });
        }
    </script>
}
