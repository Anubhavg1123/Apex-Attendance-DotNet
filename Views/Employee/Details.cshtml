@model EmployeeAttendanceApp.Models.Employee
@{
    ViewData["Title"] = $"{Model.FullName} - Profile Details";
    var todayPunch = ViewBag.TodayPunch as EmployeeAttendanceApp.Models.AttendanceRecord;
}

<div class="d-flex flex-column gap-4" style="max-width: 900px; margin: 0 auto;">
    <!-- Top Header Navigation -->
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="h3 fw-bold text-white mb-1">
                @Model.FullName
            </h2>
            <p class="text-secondary mb-0">
                Employee Profile, Biometric Credentials, & Punch Record
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Employee/Edit/@Model.Id" class="btn btn-outline-warning">
                <i class="bi bi-pencil"></i> Edit Profile
            </a>
            <a href="/Employee" class="btn-apex-secondary">
                <i class="bi bi-arrow-left"></i> Directory
            </a>
        </div>
    </div>

    <!-- Main Profile Card -->
    <div class="glass-panel p-4">
        <div class="row g-4 align-items-center">
            <div class="col-md-3 text-center">
                <div class="avatar-circle mx-auto mb-3" style="width: 110px; height: 110px; font-size: 36px; border: 3px solid var(--accent-cyan);">
                    @if (!string.IsNullOrEmpty(Model.ProfilePhotoUrl))
                    {
                        <img src="@Model.ProfilePhotoUrl" alt="@Model.FullName" />
                    }
                    else
                    {
                        <span>@Model.FullName.Substring(0, 1)</span>
                    }
                </div>
                
                @if (Model.IsFaceEnrolled)
                {
                    <span class="badge bg-success bg-opacity-25 text-success font-mono px-3 py-1 border border-success border-opacity-25">
                        <i class="bi bi-shield-check"></i> FACE ENROLLED
                    </span>
                }
                else
                {
                    <span class="badge bg-warning bg-opacity-25 text-warning font-mono px-3 py-1">
                        <i class="bi bi-shield-exclamation"></i> NO BIOMETRIC DATA
                    </span>
                }
            </div>

            <div class="col-md-9">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <h3 class="h4 fw-bold text-white mb-0">@Model.FullName</h3>
                    <span class="badge bg-info bg-opacity-25 text-cyan font-mono">@Model.EmployeeCode</span>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success text-white">Active</span>
                    }
                </div>
                <div class="text-secondary mb-3">@Model.Designation &bull; <strong class="text-white">@Model.Department</strong></div>

                <div class="row g-3 text-secondary small pt-2 border-top border-secondary border-opacity-25">
                    <div class="col-sm-6">
                        <i class="bi bi-envelope text-cyan me-2"></i>
                        <span class="text-white">@Model.Email</span>
                    </div>
                    <div class="col-sm-6">
                        <i class="bi bi-telephone text-cyan me-2"></i>
                        <span class="text-white">@(string.IsNullOrEmpty(Model.Phone) ? "Not Provided" : Model.Phone)</span>
                    </div>
                    <div class="col-sm-6">
                        <i class="bi bi-clock text-cyan me-2"></i>
                        <span class="text-white">@Model.ShiftType</span>
                    </div>
                    <div class="col-sm-6">
                        <i class="bi bi-calendar-check text-cyan me-2"></i>
                        <span>Enrolled: <strong class="text-white">@(Model.EnrolledAt?.ToString("MMM dd, yyyy") ?? "Pending")</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Today's Attendance Punch Status -->
    <div class="glass-panel p-4">
        <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-fingerprint text-cyan"></i>
            <span>Today's Shift Status</span>
        </h5>

        @if (todayPunch != null)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25">
                <div>
                    <span class="text-muted small d-block">Punch IN Time</span>
                    <span class="fw-bold text-white font-mono fs-5">@todayPunch.PunchInTime.ToString("hh:mm:ss tt")</span>
                </div>
                <div>
                    <span class="text-muted small d-block">Punch OUT Time</span>
                    <span class="fw-bold text-white font-mono fs-5">
                        @(todayPunch.PunchOutTime.HasValue ? todayPunch.PunchOutTime.Value.ToString("hh:mm:ss tt") : "Active Shift")
                    </span>
                </div>
                <div>
                    <span class="text-muted small d-block">Attendance Status</span>
                    @if (todayPunch.Status == "Present")
                    {
                        <span class="badge-status badge-present">On Time</span>
                    }
                    else if (todayPunch.Status == "Late")
                    {
                        <span class="badge-status badge-late">Late Arrival</span>
                    }
                    else
                    {
                        <span class="badge-status badge-halfday">@todayPunch.Status</span>
                    }
                </div>
                <div>
                    <span class="text-muted small d-block">Biometric Confidence</span>
                    <span class="fw-bold text-success font-mono fs-5">@todayPunch.MatchConfidence%</span>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-calendar-x fs-2 d-block mb-1 text-secondary"></i>
                No punch records logged for @Model.FullName today.
            </div>
        }
    </div>
</div>
